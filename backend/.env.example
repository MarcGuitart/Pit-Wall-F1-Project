# ── Copy this file to .env and fill in values. Never commit .env. ──────────

# OpenF1 API
OPENF1_BASE_URL=https://api.openf1.org/v1

# OpenF1 account (paid). Username/password are exchanged for a 1-hour bearer
# token that the backend renews by itself — https://openf1.org/auth.html
# Without them the client runs anonymously: only cached sessions and the
# public endpoints work. Never commit real values.
OPENF1_USERNAME=
OPENF1_PASSWORD=
# Legacy static bearer token (no renewal). Ignored when username/password are set.
OPENF1_API_TOKEN=
# Outgoing rate limit to OpenF1. Unset = by mode: 55/min with an account,
# 27/min anonymous (OpenF1 enforces 60 and 30 per minute). Set to override.
# OPENF1_RATE_LIMIT_REQUESTS=55
# OPENF1_RATE_LIMIT_WINDOW_S=60

# Where to store per-session JSON cache files
# Note: ephemeral on Render free tier — cache resets on container restart
CACHE_DIR=./cache

# Allowed CORS origins — comma-separated string or JSON array both accepted.
# Local development:
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production (set this on Render — include both www and non-www):
# CORS_ORIGINS=https://pitwallengineer.com,https://www.pitwallengineer.com,https://pit-wall-f1-project.netlify.app

# Environment flag — set to "production" on Render to disable FastF1 telemetry endpoint
ENVIRONMENT=development


# ── AI chat (both are optional — the app works without them) ────────────────

# Ollama (local) — use 127.0.0.1 to avoid IPv6 resolution issues
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Groq (cloud, used in production) — get key at console.groq.com
# If set, Groq is used when Ollama is unavailable. Must match config.py's default.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Reasoning effort for openai/gpt-oss-* models: low | medium | high
GROQ_REASONING_EFFORT=medium
